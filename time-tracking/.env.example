# ---- Admin bootstrap login (username left empty on the login screen) ----
# Dev: plain password. Production: use ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD=admin123
# Production: scrypt hash from `npm run hash-password -- '<password>'` (min 8 chars).
# When set, ADMIN_PASSWORD is ignored.
# ADMIN_PASSWORD_HASH=scrypt$<salt>$<key>
# After creating real admin users in Settings, disable the bootstrap login:
# ADMIN_BOOTSTRAP=off

# ---- HTTP(S) ----
PORT=3000
# Provide both to serve HTTPS directly; otherwise run behind nginx/Caddy.
# TLS_CERT=/etc/ssl/hrghrd/fullchain.pem
# TLS_KEY=/etc/ssl/hrghrd/privkey.pem
# Behind a reverse proxy: trust X-Forwarded-For for login rate limiting.
# TRUST_PROXY=1

# ---- Database (SQLite; default) ----
DB_PATH=./hrghrd.db
# For PostgreSQL in production see docs/PRODUCTION.md and db/postgres-schema.sql.
