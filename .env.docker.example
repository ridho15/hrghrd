# --- Pengaturan Aplikasi ---
APP_NAME="HR Group"
APP_ENV=production
APP_KEY=base64:E457r9782Vd4062v8a9R5r+e2a6d7f8g0h1i2j3k4l=
APP_DEBUG=false
APP_URL=https://hrd.playgo.id
APP_PORT=8017
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# --- Pengaturan Database MySQL & Akses Remote ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_EXTERNAL_PORT=3317
DB_DATABASE=hrg_hrd
DB_USERNAME=root
DB_PASSWORD=hrg_password
DB_ROOT_PASSWORD=rootpassword

# Parameter otomatis migrasi saat container app pertama kali menyala
RUN_MIGRATIONS=true

# --- Driver Session & Antrean ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

